# Supabase (public client keys only — never put the service-role / secret key here)
# Dashboard → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=
# Preferred (new): publishable key — sb_publishable_...
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy alias still supported: anon/public JWT key
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3002
NEXT_PUBLIC_APP_NAME=Flowza

# API performance logs (optional). In development, timing logs are on by default.
# Set API_PERF_LOG=1 to enable in production, or API_PERF_LOG=0 to silence in development.
# API_PERF_LOG=1

# Email branding (optional — fall back to NEXT_PUBLIC_APP_URL + /icons/icon-192x192.png)
# EMAIL_APP_URL=https://app.yourdomain.com
# EMAIL_LOGO_URL=https://app.yourdomain.com/icons/icon-192x192.png
# EMAIL_SUPPORT_EMAIL=support@yourdomain.com

# ---------------------------------------------------------------------------
# Auth OTP + SMTP (server-side only — never use NEXT_PUBLIC_ prefixes)
# ---------------------------------------------------------------------------
# SUPABASE_SERVICE_ROLE_KEY=   # required for OTP verify + password reset
# OTP_PEPPER=                  # optional extra secret for OTP hashing

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SENDER_NAME=Flowza
SMTP_SENDER_EMAIL=

OTP_EXPIRY_MINUTES=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5

# Auth notes:
# - Prefer app OTP emails via SMTP_* (falls back to RESEND_* if SMTP is unset)
# - Site URL should match NEXT_PUBLIC_APP_URL
# - Allow redirect: {NEXT_PUBLIC_APP_URL}/auth/callback

# Optional Playwright auth credentials (never commit real secrets)
# E2E_AUTH_EMAIL=
# E2E_AUTH_PASSWORD=
# E2E_UNVERIFIED_EMAIL=
# E2E_UNVERIFIED_PASSWORD=
# E2E_ONBOARDING_EMAIL=
# E2E_ONBOARDING_PASSWORD=

# ---------------------------------------------------------------------------
# Notifications (Phase 13) — server-side only. Never use NEXT_PUBLIC_ prefixes.
# ---------------------------------------------------------------------------
# SUPABASE_SERVICE_ROLE_KEY=   # also required for public-queue notification writes

# Email — queue notifications prefer SMTP_*, then Resend
# SMTP_* (same as auth OTP) is enough for guest queue emails
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=Flowza <notifications@yourdomain.com>

# WhatsApp Cloud API
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_BUSINESS_ACCOUNT_ID=
# Flowza queue utility template (create in Meta if missing): flowza_queue_status
# Body: Hi {{1}}, ... Status: {{2}} ... Details: {{3}}
# WHATSAPP_TEMPLATE_NAME=flowza_queue_status
# WHATSAPP_TEMPLATE_LANGUAGE=en_US
# WHATSAPP_TEMPLATE_BODY_PARAM_COUNT=3
# App WhatsApp bodies use "|||" to fill {{1}}/{{2}}/{{3}}.
# Legacy: WHATSAPP_TEMPLATE_BODY_PARAM=true means count=1.

# Web Push (staff + customer device alerts)
# Generate keys: npx web-push generate-vapid-keys
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:support@yourdomain.com

# SMS (generic HTTP provider — disabled until both are set)
# SMS_PROVIDER_API_KEY=
# SMS_PROVIDER_ENDPOINT=

# ---------------------------------------------------------------------------
# Billing / Razorpay (Phase 16) — server-side only. Never use NEXT_PUBLIC_
# for secret or webhook keys. RAZORPAY_KEY_ID may be returned to checkout.
# ---------------------------------------------------------------------------
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Platform admin (Phase 17) — grant SUPER_ADMIN only via secure SQL / ops.
# Never expose a public signup for SUPER_ADMIN. Example:
#   UPDATE public.profiles
#   SET platform_role = 'SUPER_ADMIN'
#   WHERE id = '<auth-user-uuid>';
# Service role remains server-only (SUPABASE_SERVICE_ROLE_KEY above).
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Rate limiting (Phase 18) — optional overrides (requests per 60s window).
# In-memory per isolate; use edge/WAF limits for multi-instance production.
# ---------------------------------------------------------------------------
# RATE_LIMIT_AUTH_LOGIN=10
# RATE_LIMIT_AUTH_SIGNUP=5
# RATE_LIMIT_AUTH_FORGOT_PASSWORD=5
# RATE_LIMIT_AUTH_VERIFY_OTP=10
# RATE_LIMIT_AUTH_RESEND_OTP=5
# RATE_LIMIT_BILLING_CHECKOUT=10
# RATE_LIMIT_ADMIN_API=120
# RATE_LIMIT_WEBHOOK_RAZORPAY=120
# RATE_LIMIT_PUBLIC_JOIN=8
